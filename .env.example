# Agentc benchmark environment — copy to `.env` and fill in the keys you need.
# Scripts load `.env` from the repo root. Only set what a given run requires;
# the reference agents stub LLM calls when no key is present (BENCH_STUB_MODE).

# --- LLM provider API keys ----------------------------------------------------

# OpenAI. Required for the main OpenAI-backed benchmarks (LCQA, GAIA,
# iterative refiner, composition, guard sweeps, ...).
OPENAI_API_KEY=

# Anthropic (Claude). Required for the native-Anthropic patch path.
ANTHROPIC_API_KEY=

# Together.xyz. Gates the CROSS-MODEL / scale-up runs (tab:xmodel,
# run_scaleup_ablation.py, run_rag_warmup_n200.py, run_autogen_warmup_*.py,
# run_composition_check.py). Used with BENCH_OPENAI_BASE_URL pointing at
# Together's OpenAI-compatible endpoint (https://api.together.xyz/v1).
# Without it those scripts abort with "TOGETHER_API_KEY not set".
TOGETHER_API_KEY=

# Groq. Optional: alternate open-model provider for ModelDowngrade routes.
GROQ_API_KEY=

# Hugging Face token. Required for GAIA (dataset download) and HF-hosted models.
HF_TOKEN=

# --- Benchmark configuration (optional; sensible defaults in code) ------------

# Point OpenAI-compatible clients at a non-OpenAI endpoint (e.g. Together) for
# cross-model runs. Leave unset to use the real OpenAI API.
# BENCH_OPENAI_BASE_URL=https://api.together.xyz/v1

# Run agents against stubbed LLM responses (no keys, no spend). Set to 1 to
# wire the harness up without spending money.
# BENCH_STUB_MODE=1

# Where Agentc stores traces.db / cost_model.db / optimizer_audit.db.
# Defaults to ~/.agentc.
# AGENTC_STORAGE_PATH=~/.agentc

# Initial candidate calibration is enabled by default. It keeps the reference
# response user-visible but issues real candidate requests in the background
# (up to 20 attempts per call-site version per 24h), so provider billing still
# applies. Disable it when profiling must make no additional LLM calls.
# AGENTC_OPTIMIZE_EXPLORATION=0
