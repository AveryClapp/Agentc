  "changes": [
    {
      "id": "r8-bounded-divergence-estimator",
      "category": "safety_controller_estimator_window",
      "beads": [
        "bd-nggo"
      ],
      "before": "The persisted per-site/rule divergence mean and variance accumulated every valid sample for the lifetime of the store, so stale provider or workload behavior could never age out despite the estimator being described as rolling.",
      "after": "Each site/rule retains the exact newest divergence_window samples, default 50. n_samples is a separate lifetime count; window_samples, mean, and variance describe only the retained values. Summary and observation rows are replaced atomically, hydrated before planning, and truncated to the newest values when the configured window shrinks.",
      "runtime_commit": "b73d703a9a32852b50c1876b5008a52eca1c66df",
      "contract_sync_commit": "b73d703a9a32852b50c1876b5008a52eca1c66df",
