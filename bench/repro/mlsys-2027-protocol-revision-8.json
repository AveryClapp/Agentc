      "evidence_sha256": "34d4baa623a819974eb44b9ff19387a00d8ca1b710c53150675e83cd11605bed",
      "controller_contract": "The disable path remains five consecutive raw samples above the rule budget. The retained mean does not control the disable decision.",
      "stage_c_status": "bd-nggo retired; bd-jq6c, bd-shi1.4, bd-rm0w, and bd-z5zj remain open"
    },
    {
      "id": "r8-conservative-divergence-migration",
      "category": "persistent_state_migration",
      "beads": [
        "bd-nggo"
      ],
      "before": "An aggregate-only legacy divergence summary contained no exact values from which a bounded newest-N window could be reconstructed.",
      "after": "Migration preserves the lifetime count and any already-persisted consecutive-breach streak, clears unreconstructable mean and variance, and restarts the statistical window empty. Fresh exact samples then use lifetime-continuing sequence numbers.",
      "runtime_commit": "b73d703a9a32852b50c1876b5008a52eca1c66df",
      "contract_sync_commit": "b73d703a9a32852b50c1876b5008a52eca1c66df",
